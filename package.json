{
  "name": "version-check",
  "version": "1.4.0",
  "description": "A GitHub Action to check version changes in any file format",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsdown",
    "compile": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "keywords": [
    "github-actions",
    "version-check",
    "semver"
  ],
  "author": "rxliuli",
  "license": "MIT",
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "bash -c 'pnpm build'",
      "git add dist"
    ]
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "json5": "^2.2.3",
    "semver": "^7.8.6",
    "toml": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "lint-staged": "^17.6.1",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67"
}
